{
    "manifest_version": 3,
    "name": "Locked In YouTube",
    "version": "1.0",
    "description": "A Chrome extension hides all distractions from YouTube so you stop doomscrolling and rotting your brain.",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "css": ["homepage.css"],
            "js": ["toggle.js"],
            "run_at": "document_start"
        }
    ]
}